# AUR package of the Linux release build. release.yml sets pkgver and the checksums and pushes it to the AUR on each
# release (VERSIONING.md); don't edit those here.
pkgname=swoop-bin
pkgver=0
pkgrel=1
pkgdesc='Offline file transfer between Linux and Android at the full speed of the local link'
arch=(x86_64 aarch64)
url=https://github.com/anil0403/swoop
license=(MIT)
depends=(gtk3 dbus)
optdepends=(
  'bluez: find devices with no shared network'
  'networkmanager: direct Wi-Fi link to those devices'
  'dnsmasq: host the direct link'
  'iw: link diagnostics and the hotspot channel'
)
provides=(swoop)
conflicts=(swoop)
source_x86_64=("$pkgname-$pkgver-x86_64.tar.gz::$url/releases/download/v$pkgver/swoop-linux-x86_64.tar.gz")
source_aarch64=("$pkgname-$pkgver-aarch64.tar.gz::$url/releases/download/v$pkgver/swoop-linux-aarch64.tar.gz")
sha256sums_x86_64=(SKIP)
sha256sums_aarch64=(SKIP)

package() {
  install -Dm755 bin/swoop -t "$pkgdir/usr/bin"
  install -d "$pkgdir/usr/lib"
  cp -r lib/swoop "$pkgdir/usr/lib/swoop"
  ln -s /usr/lib/swoop/swoop-app "$pkgdir/usr/bin/swoop-app"
  install -Dm644 share/applications/io.github.anil0403.swoop.desktop -t "$pkgdir/usr/share/applications"
  install -Dm644 share/licenses/swoop/LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}
